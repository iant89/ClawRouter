# systemd unit for ClawRouter (docs/deployment.md#systemd).
#   sudo cp deploy/clawrouter.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now clawrouter
# Check its sandbox with: systemd-analyze security clawrouter.service
[Unit]
Description=ClawRouter AI gateway
Documentation=https://github.com/iant89/ClawRouter/blob/main/docs/deployment.md#systemd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clawrouter
Group=clawrouter
# The production build (bun run build) installed at /opt/clawrouter; it must run from dist/.
WorkingDirectory=/opt/clawrouter/dist
EnvironmentFile=/etc/clawrouter/clawrouter.env
ExecStart=/usr/local/bin/bun main.js
# SIGTERM drains in-flight requests for CLAWROUTER_SHUTDOWN_GRACE_SECONDS (30).
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=5

# --- Hardening (SEC-024, docs/deployment.md#systemd-hardening) ---------------
# Files: whatever ClawRouter creates is private to its account (SEC-023).
UMask=0077
# Writable: only /var/lib/clawrouter (database, backups, setup token), created
# 0700 and owned by the service user. The rest of the system is read-only, home
# directories are hidden, /tmp and /dev are private. A database or backup
# directory elsewhere needs a drop-in: ReadWritePaths=/that/directory
StateDirectory=clawrouter
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# The kernel: no tunables, modules, kernel log, clock, hostname or cgroup changes.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# Other processes are invisible; /proc shows only this service's processes.
ProtectProc=invisible
ProcSubset=pid
# Privileges: none to gain or keep, and a user namespace where only the service
# account and root (unprivileged inside it) exist. Port 8080 needs no capability.
# To listen on 80 or 443 directly (rather than behind a reverse proxy), use a
# drop-in with AmbientCapabilities=CAP_NET_BIND_SERVICE,
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE and PrivateUsers=false: inside the
# user namespace the capability does not apply to the host's ports.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RemoveIPC=true
PrivateUsers=true
PrivateIPC=true
# Network: IPv4, IPv6 and local sockets only (no raw, packet or netlink sockets).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# System calls: the set a network service needs, native architecture only.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# Not set on purpose: MemoryDenyWriteExecute=true (it takes away the JavaScript
# engine's just-in-time compiler: measured 2.7 times slower), PrivateNetwork=true and
# IPAddressDeny= (providers are reached over the network; the outbound policy,
# CLAWROUTER_OUTBOUND_ALLOWLIST, decides where).

[Install]
WantedBy=multi-user.target

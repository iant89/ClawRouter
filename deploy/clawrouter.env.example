# ClawRouter configuration (production). Every variable: docs/configuration.md.
# Copy to /etc/clawrouter/clawrouter.env (systemd) or .env next to compose.yaml (Docker),
# readable by root and the service only (chmod 600).

CLAWROUTER_ENV=production

# Encryption key for stored provider API keys, the mail password and authenticator secrets.
# Generate once: openssl rand -base64 32   Keep a copy OUTSIDE the backups (password manager, vault).
# Prefer a file:   CLAWROUTER_SECRET_KEY_FILE=/etc/clawrouter/secret.key
CLAWROUTER_SECRET_KEY_FILE=/etc/clawrouter/secret.key

# Where to listen. Behind a reverse proxy on the same machine keep 127.0.0.1.
CLAWROUTER_HOST=127.0.0.1
CLAWROUTER_PORT=8080
# The reverse proxy's address, so client IPs (sign-in throttling, audit) are right.
CLAWROUTER_TRUSTED_PROXIES=127.0.0.1

# Or serve HTTPS directly instead of through a proxy:
# CLAWROUTER_TLS_CERT_FILE=/etc/clawrouter/tls/fullchain.pem
# CLAWROUTER_TLS_KEY_FILE=/etc/clawrouter/tls/privkey.pem

CLAWROUTER_DATABASE_PATH=/var/lib/clawrouter/clawrouter.db
# Backups: a copy every 24 h (the 7 newest kept), and before every migration and import.
# CLAWROUTER_BACKUP_DIR=/var/lib/clawrouter/backups
# CLAWROUTER_BACKUP_INTERVAL_HOURS=24
# CLAWROUTER_BACKUP_KEEP=7

# Optional: a fixed setup token for the first sign-in (otherwise written to <data dir>/setup-token).
# CLAWROUTER_SETUP_TOKEN=

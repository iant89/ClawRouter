{
  "name": "clawrouter",
  "version": "0.1.0",
  "private": true,
  "description": "ClawRouter: self-hosted AI model gateway and control platform.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun install",
    "ui:build": "bun scripts/build-ui.ts",
    "dev": "bun --hot apps/server/src/main.ts",
    "start": "bun scripts/start.ts",
    "build": "bun build apps/server/src/main.ts --target=bun --production --outdir=dist --entry-naming=[name].[ext] --sourcemap=linked",
    "migrate": "bun scripts/migrate.ts",
    "reset-password": "bun scripts/reset-password.ts",
    "rotate-secret-key": "bun scripts/rotate-secret-key.ts",
    "scan-secrets": "bun scripts/scan-secrets.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "@clawrouter/api": "workspace:*",
    "@clawrouter/audit": "workspace:*",
    "@clawrouter/authentication": "workspace:*",
    "@clawrouter/authorization": "workspace:*",
    "@clawrouter/core": "workspace:*",
    "@clawrouter/database": "workspace:*",
    "@clawrouter/gateway": "workspace:*",
    "@clawrouter/health": "workspace:*",
    "@clawrouter/models": "workspace:*",
    "@clawrouter/notifications": "workspace:*",
    "@clawrouter/mail": "workspace:*",
    "@clawrouter/operations": "workspace:*",
    "@clawrouter/settings": "workspace:*",
    "@clawrouter/providers": "workspace:*",
    "@clawrouter/routing": "workspace:*",
    "@clawrouter/rate-limits": "workspace:*",
    "@clawrouter/requests": "workspace:*",
    "@clawrouter/shared": "workspace:*"
  }
}

# Copy to .env (Bun loads it automatically). Never commit real secrets.
CLAWROUTER_ENV=development
CLAWROUTER_HOST=127.0.0.1
CLAWROUTER_PORT=8080
CLAWROUTER_DATABASE_PATH=./data/clawrouter.db
CLAWROUTER_LOG_LEVEL=info
# json | pretty (defaults: pretty in development, json in production)
# CLAWROUTER_LOG_FORMAT=pretty
CLAWROUTER_CONSOLE_ENABLED=true

# Sessions
CLAWROUTER_SESSION_IDLE_MINUTES=60
CLAWROUTER_SESSION_MAX_HOURS=12
# Secure cookies need HTTPS. Defaults to true when CLAWROUTER_ENV=production.
# CLAWROUTER_COOKIE_SECURE=true
# Optional pre-chosen initial setup token (otherwise generated into data/setup-token).
# CLAWROUTER_SETUP_TOKEN=

# Background health check interval
CLAWROUTER_HEALTH_INTERVAL_SECONDS=30

# Encryption key for stored provider credentials (32 bytes, base64 or hex).
# Required in production; generate with: openssl rand -base64 32
# CLAWROUTER_SECRET_KEY=
# CLAWROUTER_SECRET_KEY_FILE=/run/secrets/clawrouter_key
# Background provider health checks (0 = off)
CLAWROUTER_PROVIDER_HEALTH_INTERVAL_SECONDS=300

# Reverse proxies whose X-Forwarded-For is trusted (addresses or CIDR ranges, comma-separated).
# Leave unset unless ClawRouter runs behind a proxy.
# CLAWROUTER_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
